# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-project-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Found in Supabase Dashboard → Settings → API → service_role key (keep secret, server-only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Gemini AI Configuration (for meal nutrition analysis)
# Get your free API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Web Push / VAPID Keys (for push notifications)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
# A mailto: address used in the VAPID header (your email is fine)
VAPID_CONTACT_EMAIL=you@example.com

# Cron job secret — Vercel sends this as Bearer token to protect /api/push/send-reminders
# Generate with: openssl rand -hex 32
CRON_SECRET=your-random-secret-here
